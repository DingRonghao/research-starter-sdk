!/Inbox/research-slides/public-sample/**
/Output/**
!/Output/paper-guide/
!/Output/paper-guide/public-sample/
!/Output/paper-guide/public-sample/**
!/Output/research-note/
!/Output/research-note/public-sample/
!/Output/research-note/public-sample/**
!/Output/research-slides/
!/Output/research-slides/public-sample/
!/Output/research-slides/public-sample/**
